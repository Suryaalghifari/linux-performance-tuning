[Unit]
Description=Re-apply CPU P-States and Power limits after boot/resume (bukan tiap 30 detik)
After=multi-user.target

[Timer]
OnBootSec=10s
# Re-apply maksimal sekali sejam. Loop 30 detik menulis MSR/sysfs terus-menerus,
# membuat swap churn (bug lama) dan menaikkan suhu idle tanpa manfaat terukur.
OnUnitActiveSec=1h
Unit=linux-boost.service

[Install]
WantedBy=timers.target
